# BeerPOS environment configuration (production).
# Copy to .env (repo root) and fill real values. Never commit the real .env.

# --- Core ---
NODE_ENV=production
PORT=3001

# --- Public domain for Caddy automatic HTTPS (Let's Encrypt) ---
# DNS A/AAAA record for this domain must point to the server's public IP.
DOMAIN=midominio.com

# --- Database (provided by docker-compose service "db") ---
# For docker compose, use the service hostname "db".
DATABASE_URL=postgres://beerpos:CHANGE_ME_STRONG_PASSWORD@db:5432/beerpos
# For a managed/external Postgres, use its connection string instead, e.g.:
# DATABASE_URL=postgres://user:pass@host:5432/beerpos?sslmode=require

# --- Redis (session store migration target / socket.io adapter) ---
REDIS_URL=redis://redis:6379

# --- CORS: comma-separated list of allowed browser origins (NO "*") ---
# Should match DOMAIN (and www if used).
# Example: https://midominio.com,https://www.midominio.com
CORS_ORIGIN=https://midominio.com

# --- Reverse proxy: number of proxies in front (1 for Caddy/Nginx) ---
TRUST_PROXY=1

# --- Secrets (generate strong random values) ---
# FINGERPRINT_ENCRYPTION_KEY must be 64 hex chars (32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINGERPRINT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# Reserved for future JWT use; no insecure default in production.
JWT_SECRET=

# --- Sessions / limits (optional overrides) ---
SESSION_TTL_MS=28800000
AUTH_LIMIT_MAX=10
AUTH_LIMIT_WINDOW_MS=900000

# --- Postgres password for docker-compose (must match DATABASE_URL) ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD