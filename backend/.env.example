PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beerpos
# Optional: allow frontend origin in production (comma-separated; NEVER "*")
CORS_ORIGIN=*
# Legacy encrypted fingerprint data only; WebAuthn passkeys do not use this key.
# Keep the production value if legacy records may need to be recovered.
FINGERPRINT_ENCRYPTION_KEY=
NODE_ENV=development

# --- Sessions (optional) ---
# Set REDIS_URL to persist sessions across restarts / multiple instances.
# Leave unset for the local file store (data/sessions.json, single instance).
# REDIS_URL=redis://redis:6379

# --- DB pool tuning (optional) ---
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONN_MS=5000

# --- Auto-bootstrap (optional; for hosts without shell, e.g. Render free) ---
# DB_AUTOINIT=1 applies db/schema.sql on boot (idempotent).
# DB_AUTOINIT=1
# Create the platform admin once on first boot (6-12 digit PIN). PIN is not
# rotated on restart unless BOOTSTRAP_ADMIN_ROTATE=1.
# BOOTSTRAP_ADMIN_NAME=admin
# BOOTSTRAP_ADMIN_PIN=483920
# BOOTSTRAP_ADMIN_ROTATE=0

# --- Offsite backups (optional) ---
# Upload daily backups to any S3-compatible storage (AWS S3, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO). Leave S3_BACKUP_BUCKET empty to
# disable offsite copies (local ./backups only).
# S3_BACKUP_BUCKET=my-beerpos-backups
# S3_BACKUP_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # non-AWS only
# S3_BACKUP_REGION=auto
# S3_BACKUP_PREFIX=backups
# S3_BACKUP_FORCE_PATH_STYLE=true
# S3_BACKUP_ACCESS_KEY_ID=
# S3_BACKUP_SECRET_ACCESS_KEY=